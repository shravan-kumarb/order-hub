# Test credentials are stored encrypted in .env.enc (committed to git).
# They are NEVER stored in plain text in any source file.
#
# ── To run tests locally ─────────────────────────────────────────────────────
# 1. Obtain DOTENV_KEY from the team's secure vault / password manager.
# 2. Export it in your shell (or add to your shell profile):
#      export DOTENV_KEY=<key>
# 3. Run tests normally — credentials are decrypted at runtime:
#      npm test
#      npm run test:e2e
#
# ── To update credentials ────────────────────────────────────────────────────
# 1. Create .env locally using the variable names below (do NOT commit .env).
# 2. Encrypt and commit:
#      DOTENV_KEY=<key> npm run env:encrypt
#      git add .env.enc && git commit -m "Update encrypted test credentials"
#
# ── To generate a new DOTENV_KEY ─────────────────────────────────────────────
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Share the key via the team's secure channel — never via git or chat.
#
# ── Variable reference ───────────────────────────────────────────────────────
TEST_CARD_NAME=
TEST_CARD_EXPIRY_MONTH=
TEST_CARD_EXPIRY_YEAR=
TEST_CARD_NUMBER_SUCCESS=
TEST_CARD_NUMBER_ALT_SUCCESS=
TEST_CARD_NUMBER_DECLINED=
TEST_CARD_NUMBER_ZERO_ENDING=
