{
  "name": "takeaway-ordering",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal takeaway ordering demo focused on test strategy,automation pyramid, shift-left, and allure",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/api/server.ts",
    "test": "dotenvx run -- vitest run",
    "test:coverage": "dotenvx run -- vitest run --coverage",
    "test:unit": "dotenvx run -- vitest run tests/unit",
    "test:contract": "dotenvx run -- vitest run tests/contract",
    "test:api": "dotenvx run -- vitest run tests/api",
    "test:e2e": "dotenvx run -- playwright test",
    "test:e2e:headed": "dotenvx run -- playwright test --headed",
    "test:e2e:ui": "dotenvx run -- playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "env:encrypt": "dotenvx encrypt",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "allure-vitest": "^3.10.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
